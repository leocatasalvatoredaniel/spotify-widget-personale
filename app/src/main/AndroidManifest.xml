<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <!-- Launching and controlling the Spotify app -->
        <package android:name="com.spotify.music" />
        <!-- Output switcher of the system, as the button of the media player -->
        <intent>
            <action android:name="com.android.settings.panel.action.MEDIA_OUTPUT" />
        </intent>
        <intent>
            <action android:name="com.android.systemui.action.LAUNCH_MEDIA_OUTPUT_DIALOG" />
        </intent>
    </queries>

    <application
        android:name=".WidgetApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WidgetMusica">

        <!-- Settings, also opened when the widget is edited from the home screen -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- Play pressed with Spotify closed: opens Spotify and starts the music -->
        <activity
            android:name=".ui.LaunchSpotifyActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.WidgetMusica.Translucent" />

        <!-- Reads what Spotify is playing and controls it, as the media player of the system -->
        <service
            android:name=".playback.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.SpotifyWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spotify_widget_info" />
        </receiver>

    </application>

</manifest>
